VITE_SITE_URL=https://www.1stclassexpress.com.au
# Optional: use a separate Formspree endpoint for careers file uploads.
VITE_CAREERS_FORM_ENDPOINT=

# ---------------------------------------------------------------------------
# Freight quote system
# ---------------------------------------------------------------------------

# Client (safe to expose — used by the browser admin sign-in only)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Version of the freight terms shown in the wizard. The server records its own
# FREIGHT_TERMS_VERSION against each quote; keep these in sync on deploy.
VITE_FREIGHT_TERMS_VERSION=2026-09-01

# Server only (set in Vercel project env — never commit real values)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
FREIGHT_TERMS_VERSION=2026-09-01

# Comma-separated list of emails allowed into /admin/quotes
ADMIN_EMAILS=

# Resend (operational email). Sending is skipped when unset.
RESEND_API_KEY=
QUOTE_FROM_EMAIL=quotes@1stclassexpress.com.au
QUOTE_INTERNAL_EMAIL=operations@1stclassexpress.com.au
