{
  "trailingSlash": false,
  "redirects": [
    { "source": "/about-us", "destination": "/about", "permanent": true },
    { "source": "/our-services", "destination": "/services", "permanent": true },
    { "source": "/our-fleet", "destination": "/fleet", "permanent": true },
    { "source": "/book-now", "destination": "/quote", "permanent": true }
  ],
  "rewrites": [
    { "source": "/about", "destination": "/about/index.html" },
    { "source": "/services", "destination": "/services/index.html" },
    { "source": "/services/same-day", "destination": "/services/same-day/index.html" },
    { "source": "/services/after-hours", "destination": "/services/after-hours/index.html" },
    { "source": "/services/interstate", "destination": "/services/interstate/index.html" },
    { "source": "/services/bulk-freight", "destination": "/services/bulk-freight/index.html" },
    { "source": "/services/backup-drivers", "destination": "/services/backup-drivers/index.html" },
    { "source": "/services/home-deliveries", "destination": "/services/home-deliveries/index.html" },
    { "source": "/services/logistics-support", "destination": "/services/logistics-support/index.html" },
    { "source": "/services/dangerous-goods", "destination": "/services/dangerous-goods/index.html" },
    { "source": "/fleet", "destination": "/fleet/index.html" },
    { "source": "/fleet/vans", "destination": "/fleet/vans/index.html" },
    { "source": "/fleet/pallet-trucks", "destination": "/fleet/pallet-trucks/index.html" },
    { "source": "/fleet/rigid-trucks", "destination": "/fleet/rigid-trucks/index.html" },
    { "source": "/fleet/prime-movers", "destination": "/fleet/prime-movers/index.html" },
    { "source": "/fleet/semi-trailers", "destination": "/fleet/semi-trailers/index.html" },
    { "source": "/fleet/b-doubles", "destination": "/fleet/b-doubles/index.html" },
    { "source": "/service-areas", "destination": "/service-areas/index.html" },
    { "source": "/service-areas/sydney", "destination": "/service-areas/sydney/index.html" },
    { "source": "/service-areas/nsw", "destination": "/service-areas/nsw/index.html" },
    { "source": "/service-areas/interstate/sydney-melbourne", "destination": "/service-areas/interstate/sydney-melbourne/index.html" },
    { "source": "/service-areas/interstate/sydney-brisbane", "destination": "/service-areas/interstate/sydney-brisbane/index.html" },
    { "source": "/service-areas/interstate/sydney-canberra", "destination": "/service-areas/interstate/sydney-canberra/index.html" },
    { "source": "/quote", "destination": "/quote/index.html" },
    { "source": "/quote/:reference/confirmation", "destination": "/app.html" },
    { "source": "/quote/:reference/respond", "destination": "/app.html" },
    { "source": "/admin", "destination": "/app.html" },
    { "source": "/admin/quotes", "destination": "/app.html" },
    { "source": "/admin/quotes/:reference", "destination": "/app.html" },
    { "source": "/customer-application", "destination": "/customer-application/index.html" },
    { "source": "/freight-terms", "destination": "/freight-terms/index.html" },
    { "source": "/contact", "destination": "/contact/index.html" },
    { "source": "/careers", "destination": "/careers/index.html" },
    { "source": "/driver-handbook", "destination": "/driver-handbook/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
